# Copy to .env (not versioned) and fill in.
DB_URL=jdbc:postgresql://localhost:5433/conversa
DB_USER=conversa
DB_PASSWORD=conversa

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v24.0

# Conversation engine: answers customers with Claude when ANTHROPIC_API_KEY is set (off: only records)
ASSISTANT_ENABLED=true
ASSISTANT_EFFORT=low
# Approved WhatsApp template that alerts staff numbers of a handoff ({{1}} customer, {{2}} reason)
HANDOFF_STAFF_ALERT_TEMPLATE=
# Approved WhatsApp template for new orders ({{1}} number, {{2}} customer, {{3}} delivery/pickup, {{4}} total)
ORDERS_STAFF_ALERT_TEMPLATE=

# Tenant seeded at startup (the pilot restaurant; in development, the Cloud API test number).
# BOOTSTRAP_TENANT_CONFIG is a JSON object validated against the pack schema; when set it replaces
# the stored settings on every start. BOOTSTRAP_ACCESS_TOKEN_REF names the variable holding this
# number's token (empty: WHATSAPP_ACCESS_TOKEN).
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_TENANT_CONFIG={"business": {"name": "Restaurante Piloto", "city": "Bonfim Paulista"}}
BOOTSTRAP_PHONE_NUMBER_ID=
BOOTSTRAP_WABA_ID=
BOOTSTRAP_ACCESS_TOKEN_REF=
# Folder with menu.csv, options.csv, hours.csv and zones.csv (docs/IMPORT.md), imported on every start.
BOOTSTRAP_DATA_DIR=

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5

# Host ports (5432/8080 are often taken by other projects)
POSTGRES_PORT=5433
SERVER_PORT=8081
