# Copie para .env (não versionado) e preencha.
DB_URL=jdbc:postgresql://localhost:5433/conversa
DB_USER=conversa
DB_PASSWORD=conversa

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v24.0

ANTHROPIC_API_KEY=
